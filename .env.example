# The backend API URL — the ONE place the frontend gets it from.
# Read by src/lib/axios.js. No trailing slash, no /api suffix.
#
# Local backend:  http://localhost:4000
# Deployed:       https://ascension-mini-back-production.up.railway.app
#
# For a deployed frontend, set this in your host's build environment too.
VITE_API_URL=http://localhost:4000
